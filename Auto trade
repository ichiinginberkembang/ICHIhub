-- TRAVEL
---------------------------------------------------------------
local function DestroyMover(mv)
    if not mv then return end
    if mv.mover then
        pcall(function() mv.mover.Velocity = Vector3.zero end)
        pcall(function() mv.mover:Destroy() end)
    end
    if mv.attachment then pcall(function() mv.attachment:Destroy() end) end
    mv.mover, mv.attachment = nil, nil
end

local function CreateMover(hrp)
    local attachment, mover = nil, nil
    local ok = pcall(function()
        attachment = Instance.new("Attachment")
        attachment.Name = "BloxParkMove"
        attachment.Parent = hrp
        mover = Instance.new("LinearVelocity")
        mover.Name = "BloxParkVelocity"
        mover.Attachment0 = attachment
        mover.RelativeTo = Enum.ActuatorRelativeTo.World
        mover.MaxForce = math.huge
        mover.Velocity = Vector3.zero
        mover.Parent = hrp
    end)
    if ok and mover then return mover, attachment end
    if attachment then pcall(function() attachment:Destroy() end) end
    local okBV = pcall(function()
        mover = Instance.new("BodyVelocity")
        mover.Name = "BloxParkVelocity"
        mover.MaxForce = Vector3.new(1000000, 1000000, 1000000)
        mover.Velocity = Vector3.zero
        mover.Parent = hrp
    end)
    if okBV and mover then return mover, nil end
    return nil
end

local function FinishTravel(arrived)
    local mv = STATE.move
    STATE.move = nil
    STATE.traveling = false
    if not mv then return nil, nil end
    local _, _, hrp = GetCharParts()
    if hrp then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
        pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
    end
    DestroyMover(mv)
    if arrived then return mv.seat, mv.area end
    return nil, nil
end

local function CancelTravel() FinishTravel(false) end

local function StartTravel(hrp, seat, area, dist)
    CancelTravel()
    local mover, attachment = CreateMover(hrp)
    if not mover then
        pcall(function() hrp.CFrame = CFrame.new(seat.Position) end)
        return false
    end
    STATE.move = { target = seat.Position, seat = seat, area = area, mover = mover, attachment = attachment, speed = CONFIG.TravelSpeed, deadline = os.clock() + CONFIG.MaxTravelTime }
    STATE.traveling = true
    STATE.seat, STATE.seatArea = seat, area
    if not STATE.tradeOpen then SetStatus(string.format("Menuju kursi %s (%.0f studs)...", area.Name, dist), COL.idle) end
    return true
end

local function StepTravel(hrp)
    local mv = STATE.move
    if not mv then return false end
    if not STATE.alive or not STATE.running then CancelTravel() return false end
    if os.clock() > mv.deadline then FinishTravel(false) return false end
    if not mv.mover or not mv.mover.Parent then FinishTravel(false) return false end
    local delta = mv.target - hrp.Position
    local dist = delta.Magnitude
    if dist <= CONFIG.ArriveDist then return true end
    local speed = math.min(mv.speed, dist / CONFIG.TravelStep)
    local ok = pcall(function() mv.mover.Velocity = delta.Unit * speed end)
    if not ok then FinishTravel(false) return false end
    return false
end

local function SitOnSeat(seat, hum, hrp)
    if hum.SeatPart == seat then return true end
    if not seat or not seat.Parent or not seat:IsA("Seat") then return false, "kursi hilang" end
    if not IsSeatAvailable(seat) then return false, "kursi sudah dipakai orang lain" end
    local ok = pcall(function() seat:Sit(hum) end)
    if not ok then pcall(function() hum.Sit = true end) end
    local t0 = os.clock()
    while (os.clock() - t0) < CONFIG.ClaimTimeout do
        if not STATE.alive then return false, "script di-unload" end
        if not STATE.running then return false, "parkir dihentikan" end
        if hum.SeatPart == seat then STATE.sitFails = 0 ClearSeatBlock(seat) return true end
        task.wait(0.1)
    end
    return false, "gagal duduk (kursi di-claim server)"
end

local function GoToSeat(force)
    if not STATE.running then return false end
    if STATE.tradeOpen then return false end
    local char, hum, hrp = GetCharParts()
    if not char then return false end
    if STATE.move then return false end
    if STATE.resetting and not force then return false end
    local seat, err, area = EnsureSeat(hrp)
    if not seat then
        if err and (os.clock() - STATE.lastSeatTry) > CONFIG.SeatRetry then STATE.lastSeatTry = os.clock() SetStatus(err, COL.warn) end
        return false
    end
    if hum.SeatPart == seat then
        if not STATE.tradeOpen then SetStatus("Parkir di " .. area.Name .. " - menunggu trade...", COL.idle) end
        return true
    end
    local dist = (hrp.Position - seat.Position).Magnitude
    if dist > CONFIG.SitReach then
        if StartTravel(hrp, seat, area, dist) then return false end
    end
    local ok, why = SitOnSeat(seat, hum, hrp)
    if ok then SetStatus("Duduk di " .. area.Name .. " - menunggu trade...", COL.idle) return true end
    if why == "parkir dihentikan" or why == "script di-unload" then return false end
    STATE.sitFails = STATE.sitFails + 1
    UpdateCounters()
    if why == "gagal duduk (kursi di-claim server)" then BlacklistSeat(seat, why) end
    SetStatus("Gagal duduk: " .. tostring(why), COL.warn)
    STATE.seat = nil
    UpdateSeatLabel()
    return false
end

