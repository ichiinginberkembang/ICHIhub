local fullScanUsed = {}
local function QueryPartsNear(center, radius)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = { workspace }
    params.MaxParts = 512
    local ok, parts = pcall(function() return workspace:GetPartBoundsInRadius(center, radius, params) end)
    if not ok or type(parts) ~= "table" then return {} end
    return parts
end

local function AddTag(inst) if not inst then return end local ok, has = pcall(function() return CollectionService:HasTag(inst, SEAT_TAG) end) if ok and has then return end pcall(function() CollectionService:AddTag(inst, SEAT_TAG) end) end
local function RemoveTag(inst) if not inst then return end local ok, has = pcall(function() return CollectionService:HasTag(inst, SEAT_TAG) end) if not ok or not has then return end pcall(function() CollectionService:RemoveTag(inst, SEAT_TAG) end) end

local function CollectAreaTables(area)
    local tables, seen = {}, {}
    for _, inst in ipairs(QueryPartsNear(area.Center, area.Radius + CONFIG.TableRadius)) do
        if inst:IsA("BasePart") and not seen[inst] and NameMatch(inst, TABLE_HINTS) then seen[inst] = true tables[#tables + 1] = inst end
    end
    return tables
end

local function EvaluateSeat(seat, area, tables)
    if not seat or not seat.Parent or not seat:IsA("Seat") then return nil, nil, "bukan kursi" end
    local anchorDist = (seat.Position - area.Center).Magnitude
    if anchorDist > area.Radius then return nil, nil, "luar area" end
    local tableDist = nil
    for _, tpart in ipairs(tables) do
        if tpart ~= seat then
            local d = (tpart.Position - seat.Position).Magnitude
            if not tableDist or d < tableDist then tableDist = d end
        end
    end
    local nearTable = (tableDist ~= nil) and (tableDist <= CONFIG.TableRadius) or false
    local hasTable = (#tables > 0)
    local seatNameOk = NameMatch(seat, SEAT_HINTS)
    local tradeName = NameHas(seat.Name, { "trade" })
    if hasTable and not nearTable then return nil, nil, "jauh dari meja" end
    if not hasTable and not seatNameOk then return nil, nil, "nama kursi tidak cocok" end
    local score = anchorDist
    if tableDist then score = score + tableDist * 2 end
    if nearTable then score = score - 2 end
    if seatNameOk then score = score - 1 end
    if tradeName then score = score - 6 end
    return score, { anchorDist = anchorDist, tableDist = tableDist, nearTable = nearTable, seatNameOk = seatNameOk, tradeName = tradeName }
end

local function AddCandidate(list, seen, inst)
    if not inst or seen[inst] then return end
    if not inst:IsA("Seat") or not inst.Parent then return end
    seen[inst] = true
    list[#list + 1] = inst
end

local function CollectSeatCandidates(area)
    local list, seen = {}, {}
    for _, seat in ipairs(CollectionService:GetTagged(SEAT_TAG)) do AddCandidate(list, seen, seat) end
    for _, inst in ipairs(QueryPartsNear(area.Center, area.Radius)) do AddCandidate(list, seen, inst) end
    if #list == 0 and not fullScanUsed[area.Name] then
        fullScanUsed[area.Name] = true
        for _, inst in ipairs(workspace:GetDescendants()) do AddCandidate(list, seen, inst) end
    end
    return list
end

local function FindSeatInArea(area)
    for seat, untilTime in pairs(STATE.seatBlock) do
        if not seat.Parent or os.clock() >= untilTime then STATE.seatBlock[seat] = nil end
    end
    local tables = CollectAreaTables(area)
    local candidates = CollectSeatCandidates(area)
    local best, bestScore, bestInfo = nil, nil, nil
    local rejectedNear, occupied, blocked = 0, 0, 0
    for _, seat in ipairs(candidates) do
        local score, info, reason = EvaluateSeat(seat, area, tables)
        if score then
            if IsSeatBlacklisted(seat) then blocked = blocked + 1
            elseif not IsSeatAvailable(seat) then occupied = occupied + 1
            elseif not bestScore or score < bestScore then best, bestScore, bestInfo = seat, score, info end
        else
            if reason ~= "luar area" then rejectedNear = rejectedNear + 1 RemoveTag(seat) end
        end
    end
    if best then AddTag(best) end
    return best, bestInfo, rejectedNear, occupied, blocked, #tables
end

local function GetNearestArea(pos)
    local best, bestDist = nil, nil
    for _, area in ipairs(CONFIG.Areas) do
        local d = (area.Center - pos).Magnitude
        if not bestDist or d < bestDist then best, bestDist = area, d end
    end
    return best, bestDist
end

local function EnsureSeat(hrp)
    local area, areaDist = GetNearestArea(hrp.Position)
    if not area then return nil, "Area kursi belum dikonfigurasi" end
    if areaDist > CONFIG.MaxSeatDist then return nil, string.format("Terlalu jauh dari area (%s, %.0f studs) - salah sea?", area.Name, areaDist) end
    local _, hum = GetCharParts()
    local sitting = hum and hum.SeatPart
    if sitting and sitting:IsA("Seat") and (sitting.Position - area.Center).Magnitude <= area.Radius then
        STATE.seat, STATE.seatArea = sitting, area
        return sitting, nil, area
    end
    local pin = STATE.pinSeat
    if pin and pin.Parent and pin:IsA("Seat") and IsSeatUsable(pin) then
        local pinArea = GetNearestArea(pin.Position)
        if pinArea == area then STATE.seat, STATE.seatArea = pin, area return pin, nil, area end
    end
    local cached = STATE.seat
    if cached and cached.Parent and STATE.seatArea == area and IsSeatUsable(cached) then return cached, nil, area end
    local found, info, rejectedNear, occupied, blocked, tableCount = FindSeatInArea(area)
    if not found then
        STATE.seat, STATE.seatArea = nil, nil
        UpdateSeatLabel()
        local parts = {}
        if occupied > 0 then parts[#parts + 1] = string.format("%d kursi dipakai orang", occupied) end
        if blocked > 0 then parts[#parts + 1] = string.format("%d kursi diblokir sementara", blocked) end
        if rejectedNear > 0 then parts[#parts + 1] = string.format("%d kursi bukan kursi trade", rejectedNear) end
        if tableCount == 0 then parts[#parts + 1] = "meja trade tidak terdeteksi" end
        local extra = (#parts > 0) and (" (" .. table.concat(parts, ", ") .. ")") or ""
        return nil, string.format("Kursi trade tidak bisa dipakai di %s%s. Duduk manual lalu klik 'Pin Kursi'.", area.Name, extra)
    end
    STATE.seat, STATE.seatArea = found, area
    UpdateSeatLabel()
    print(string.format("[PARK] Kursi dipakai: %s | area=%s | jarak anchor=%.1f stud%s", found:GetFullName(), area.Short, info and info.anchorDist or -1, (info and info.tableDist) and string.format(" | ke meja=%.1f", info.tableDist) or " | meja tidak terdeteksi"))
    return found, nil, area
end

