-- AUTO KICK
---------------------------------------------------------------
local DECLINE_NAMES = { Decline = true, Declined = true, Cancel = true, CancelButton = true, Close = true, CloseButton = true, Exit = true, X = true }
local function TryPressDecline(ui)
    if type(firesignal) ~= "function" then return false end
    if not IsTradeUiCandidate(ui) then return false end
    for _, descendant in ipairs(ui:GetDescendants()) do
        if descendant:IsA("GuiButton") and DECLINE_NAMES[descendant.Name] then
            local ok = pcall(function() firesignal(descendant.MouseButton1Click) end)
            if ok then return true end
        end
    end
    return false
end
local function KickWrongTrader(partner)
    if STATE.resetting then return end
    if (os.clock() - STATE.lastKick) < CONFIG.KickCooldown then return end
    local _, hum = GetCharParts()
    if not hum then return end
    STATE.lastKick = os.clock()
    STATE.resetting = true
    STATE.wrongCount = STATE.wrongCount + 1
    UpdateCounters()
    SetStatus(string.format("Salah orang (%s) - mengusir...", tostring(partner or "?")), COL.bad)
    print(string.format("[PARK] Salah trader: %s (usir #%d)", tostring(partner), STATE.wrongCount))
    local ui = FindTradeUi()
    if ui then TryPressDecline(ui) end
    CancelTravel()
    pcall(function() hum.Sit = false end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    local t0 = os.clock()
    while (os.clock() - t0) < 1.0 do if hum.SeatPart == nil and not hum.Sit then break end task.wait(0.05) end
    if hum.SeatPart ~= nil then pcall(function() hum.Jump = true end) task.wait(0.25) end
    task.wait(CONFIG.KickGrace)
    STATE.resetting = false
    if STATE.alive and STATE.running then
        STATE.tradeOpen = IsTradeOpen(FindTradeUi(true))
        if not GoToSeat(true) and not STATE.move then SetStatus("Gagal kembali ke kursi - dicoba lagi...", COL.warn) end
    end
    UpdateCounters()
end

