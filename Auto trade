local function SavePinToFile(seat)
    if type(writefile) ~= "function" then return end
    local data = string.format("%.3f,%.3f,%.3f", seat.Position.X, seat.Position.Y, seat.Position.Z)
    local ok = pcall(function() writefile(PIN_FILE, data) end)
    if not ok then print("[PARK] Gagal menyimpan pin ke file.") end
end
local function LoadPinFromFile()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
    local okFile, exists = pcall(isfile, PIN_FILE)
    if not okFile or not exists then return nil end
    local okRead, data = pcall(readfile, PIN_FILE)
    if not okRead or type(data) ~= "string" or data == "" then return nil end
    local x, y, z = string.match(data, "([^,]+),([^,]+),([^,]+)")
    local px, py, pz = tonumber(x), tonumber(y), tonumber(z)
    if not (px and py and pz) then return nil end
    local targetPos = Vector3.new(px, py, pz)
    local best, bestDist = nil, nil
    for _, inst in ipairs(QueryPartsNear(targetPos, 6)) do
        if inst:IsA("Seat") and inst.Parent then
            local d = (inst.Position - targetPos).Magnitude
            if not bestDist or d < bestDist then best, bestDist = inst, d end
        end
    end
    if best then print(string.format("[PARK] Pin dimuat: %s (%.1f stud dari posisi tersimpan)", best:GetFullName(), bestDist)) end
    return best
end
local function PinCurrentSeat()
    local char, hum, hrp = GetCharParts()
    if not char then SetStatus("Karakter belum siap - coba lagi.", COL.warn) return end
    local seat = hum.SeatPart
    if not (seat and seat:IsA("Seat")) then
        local best, bestDist = nil, nil
        for _, inst in ipairs(QueryPartsNear(hrp.Position, 14)) do
            if inst:IsA("Seat") then
                local d = (inst.Position - hrp.Position).Magnitude
                if not bestDist or d < bestDist then best, bestDist = inst, d end
            end
        end
        seat = best
    end
    if not seat then SetStatus("Tidak ada kursi di dekatmu. Duduk di kursi trade dulu, lalu klik Pin.", COL.warn) return end
    STATE.pinSeat = seat
    STATE.seat = seat
    STATE.seatArea = GetNearestArea(seat.Position)
    AddTag(seat)
    SavePinToFile(seat)
    UpdateSeatLabel()
    SetStatus("Kursi di-pin: " .. tostring(seat.Name) .. " (disimpan)", COL.good)
    print(string.format("[PARK] PIN kursi: %s @ %.1f, %.1f, %.1f", seat:GetFullName(), seat.Position.X, seat.Position.Y, seat.Position.Z))
end

