local TRADE_NAMES = { Trade = true, TradeFrame = true, TradeGui = true, TradeGUI = true, TradeWindow = true }
local function IsTradeUiCandidate(inst)
    if not inst or not inst.Parent then return false end
    local okClass, className = pcall(function() return inst.ClassName end)
    if okClass and className == "ScreenGui" then return true end
    local okGui, isGui = pcall(function() return inst:IsA("GuiObject") end)
    return okGui and isGui == true
end
local function UiArea(inst) local ok, size = pcall(function() return inst.AbsoluteSize end) if ok and size and size.X and size.Y then return size.X * size.Y end return 0 end
local function IsShown(inst)
    if inst.ClassName == "ScreenGui" then local ok, enabled = pcall(function() return inst.Enabled end) return (not ok) or enabled ~= false end
    if inst:IsA("GuiObject") then local ok, visible = pcall(function() return inst.Visible end) return ok and visible ~= false end
    return false
end
local function FindTradeUi(force)
    local cached = STATE.tradeUi
    if cached then if IsTradeUiCandidate(cached) then return cached end STATE.tradeUi = nil end
    local now = os.clock()
    if not force and (now - STATE.lastUiScan) < CONFIG.UiScanInterval then return nil end
    STATE.lastUiScan = now
    local mainGui = PlayerGui:FindFirstChild("Main")
    if not mainGui then return nil end
    local best, bestArea = nil, -1
    for _, inst in ipairs(mainGui:GetDescendants()) do
        if TRADE_NAMES[inst.Name] and IsTradeUiCandidate(inst) then
            local area = UiArea(inst)
            if area > bestArea then best, bestArea = inst, area end
        end
    end
    STATE.tradeUi = best
    return best
end
local function AncestorsVisible(inst)
    local cur = inst
    while cur and cur ~= PlayerGui do
        if cur:IsA("GuiObject") then local ok, visible = pcall(function() return cur.Visible end) if ok and visible == false then return false end end
        cur = cur.Parent
    end
    return true
end
local function IsTradeOpen(ui)
    if not IsTradeUiCandidate(ui) then return false end
    if not IsShown(ui) then return false end
    if not AncestorsVisible(ui) then return false end
    if ui:IsA("GuiObject") then return UiArea(ui) > 0 end
    return true
end
local function BuildNameMap()
    local map = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            map[plr.Name] = plr.Name
            local dn = plr.DisplayName
            if dn and dn ~= "" and dn ~= plr.Name then map[dn] = plr.Name end
        end
    end
    return map
end
local nameMapCache = nil
local nameMapAt = 0
local function GetNameMap()
    local now = os.clock()
    if not nameMapCache or (now - nameMapAt) > 1.0 then nameMapCache, nameMapAt = BuildNameMap(), now end
    return nameMapCache
end
local function InvalidateNameMap() nameMapCache = nil nameMapAt = 0 end
local function GetPartnerFromUi(ui, nameMap)
    local texts = {}
    for _, descendant in ipairs(ui:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
            local txt = descendant.Text
            if type(txt) == "string" and txt ~= "" then
                local canon = nameMap[txt]
                if canon then return canon end
                texts[#texts + 1] = txt
            end
        end
    end
    for _, txt in ipairs(texts) do
        for key, canon in pairs(nameMap) do if #key >= 3 and string.find(txt, key, 1, true) then return canon end end
    end
    return nil
end
local function GetNearestPlayer(maxDist, myPos)
    local best, bestDist = nil, maxDist
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myPos).Magnitude
                if d < bestDist then best, bestDist = plr.Name, d end
            end
        end
    end
    return best, bestDist
end

