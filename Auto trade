local function Connect(signal, fn)
    local conn = signal:Connect(fn)
    table.insert(STATE.conns, conn)
    return conn
end

local function Create(className, props)
    local inst = Instance.new(className)
    local parent = nil
    for k, v in pairs(props) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function GetCharParts()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return nil end
    return char, hum, hrp
end

local function Trim(s) return (tostring(s):gsub("^%s+", ""):gsub("%s+$", "")) end

local function NameHas(name, hints)
    local low = string.lower(tostring(name or ""))
    if low == "" then return false end
    for i = 1, #hints do
        if string.find(low, hints[i], 1, true) then return true end
    end
    return false
end

local function NameMatch(inst, hints)
    local cur, depth = inst, 0
    while cur and depth < 3 do
        if NameHas(cur.Name, hints) then return true end
        cur = cur.Parent
        depth = depth + 1
    end
    return false
end

