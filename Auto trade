local function IsSeatBlacklisted(seat)
    local untilTime = STATE.seatBlock[seat]
    if not untilTime then return false end
    if os.clock() >= untilTime then STATE.seatBlock[seat] = nil return false end
    return true
end

local function BlacklistSeat(seat, reason)
    if not seat then return end
    STATE.seatBlock[seat] = os.clock() + CONFIG.SeatBlockTime
    print(string.format("[PARK] Kursi diblokir %.0fs: %s (%s)", CONFIG.SeatBlockTime, tostring(seat.Name), tostring(reason)))
end

local function ClearSeatBlock(seat) if seat then STATE.seatBlock[seat] = nil end end

local function IsOccupantReal(seat, occupant)
    if not occupant then return false end
    local okType, isHumanoid = pcall(function() return occupant:IsA("Humanoid") end)
    if not okType or not isHumanoid then return false end

    local okState, seated = pcall(function() return occupant.Sit == true and occupant.SeatPart == seat and occupant.Health > 0 end)
    if not okState or not seated then return false end

    local character = occupant.Parent
    if not character or not character:IsA("Model") or not character.Parent then return false end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local okPos, dist = pcall(function() return (hrp.Position - seat.Position).Magnitude end)
    if not okPos or dist > CONFIG.GhostDistance then return false end

    local plr = Players:GetPlayerFromCharacter(character)
    if plr and not plr.Parent then return false end
    return true
end

local function IsSeatAvailable(seat)
    if not seat or not seat.Parent or not seat:IsA("Seat") then return false end
    local _, hum = GetCharParts()
    if hum and seat.Occupant == hum then return true end
    local occupant = seat.Occupant
    if not occupant then return true end
    if IsOccupantReal(seat, occupant) then return false end

    if not STATE.ghostSeen[seat] then
        STATE.ghostSeen[seat] = true
        print(string.format("[PARK] Kursi '%s' punya occupant hantu (%s) - dianggap bebas.", tostring(seat.Name), tostring(occupant.Name)))
    end
    return true
end

local function IsSeatUsable(seat) return IsSeatAvailable(seat) and not IsSeatBlacklisted(seat) end

