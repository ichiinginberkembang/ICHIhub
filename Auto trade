-- LOOP UTAMA
---------------------------------------------------------------
local function SitAfterTravel(seat, area, hum, hrp)
    if not (seat and seat.Parent) then return false end
    if CONFIG.SettleTime > 0 then task.wait(CONFIG.SettleTime) end
    local ok, why = SitOnSeat(seat, hum, hrp)
    if ok then SetStatus("Duduk di " .. ((area and area.Name) or "kursi") .. " - menunggu trade...", COL.idle) return true end
    if why == "parkir dihentikan" or why == "script di-unload" then return false end
    STATE.sitFails = STATE.sitFails + 1
    UpdateCounters()
    if why == "gagal duduk (kursi di-claim server)" then BlacklistSeat(seat, why) end
    SetStatus("Gagal duduk: " .. tostring(why), COL.warn)
    STATE.seat = nil
    UpdateSeatLabel()
    return false
end

local function Tick()
    if not STATE.running then return CONFIG.PollIdle end
    if STATE.resetting then return 0.1 end
    local _, hum, hrp = GetCharParts()
    if not hum then CancelTravel() return 0.5 end
    local ui = FindTradeUi()
    local open = IsTradeOpen(ui)
    STATE.tradeOpen = open
    if STATE.move then
        if open then CancelTravel() SetStatus("Trade kebuka saat terbang - berhenti dulu.", COL.warn) return 0.1 end
        if StepTravel(hrp) then
            local seat, area = FinishTravel(true)
            SitAfterTravel(seat, area, hum, hrp)
        else return CONFIG.TravelStep end
    end
    if not hum.SeatPart and not open then if not GoToSeat(false) then return CONFIG.PollIdle end end
    if not open then return CONFIG.PollIdle end
    local partner = GetPartnerFromUi(ui, GetNameMap())
    if not partner then partner = GetNearestPlayer(CONFIG.PartnerRadius, hrp.Position) end
    if partner then
        if partner ~= STATE.target then KickWrongTrader(partner) return 0.1 end
        SetStatus(string.format("Target datang (%s) - silakan trade!", partner), COL.good)
    else SetStatus("Trade terbuka, partner belum terdeteksi...", COL.warn) end
    return CONFIG.PollTrade
end

